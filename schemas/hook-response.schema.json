{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codefoundry.ai/schemas/hook-response.schema.json",
  "title": "CodeFoundry Hook Response Schema",
  "description": "Schema for hook response payloads",
  "type": "object",
  "required": ["status", "continue"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "blocked", "failed", "skip"],
      "description": "Hook execution status"
    },
    "continue": {
      "type": "boolean",
      "description": "Whether to continue stage execution"
    },
    "reason": {
      "type": "string",
      "description": "Reason for blocking or failure"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "additionalProperties": true
    },
    "overrides": {
      "type": "object",
      "description": "Configuration overrides (pre_subagent hook)",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "max_turns": {"type": "integer"},
            "max_tokens": {"type": "integer"},
            "timeout_minutes": {"type": "integer"}
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "template_vars": {
          "type": "object",
          "description": "Variables to inject into template",
          "additionalProperties": true
        }
      }
    },
    "validation": {
      "type": "object",
      "description": "Validation result (post_subagent hook)",
      "properties": {
        "passed": {"type": "boolean"},
        "checks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer"},
              "message": {"type": "string"},
              "severity": {"type": "string", "enum": ["error", "warning", "info"]}
            }
          }
        }
      }
    },
    "merge_approved": {
      "type": "boolean",
      "description": "Whether merge is approved (pre_merge hook)"
    },
    "escalation_required": {
      "type": "boolean",
      "description": "Whether human escalation is required"
    },
    "escalation_reason": {
      "type": "string",
      "description": "Reason for escalation"
    }
  }
}
