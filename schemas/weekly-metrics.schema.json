{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codefoundry.ai/schemas/weekly-metrics.schema.json",
  "title": "CodeFoundry Weekly Metrics Schema",
  "description": "Schema for generated weekly metrics reports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "week",
    "success_rate",
    "success_rate_confidence",
    "avg_confidence",
    "avg_rubric_score",
    "avg_cycle_time",
    "p1_findings",
    "p2_findings",
    "p3_findings",
    "gate_pass_rate",
    "replay_pass_rate",
    "determinism_confidence",
    "runs_completed",
    "runs_failed",
    "total_runs"
  ],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "success_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "success_rate_confidence": {
      "$ref": "#/definitions/binomialConfidence"
    },
    "avg_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "avg_rubric_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "avg_cycle_time": {
      "type": "integer",
      "minimum": 0,
      "description": "Duration in nanoseconds (Go time.Duration JSON encoding)."
    },
    "p1_findings": {
      "type": "integer",
      "minimum": 0
    },
    "p2_findings": {
      "type": "integer",
      "minimum": 0
    },
    "p3_findings": {
      "type": "integer",
      "minimum": 0
    },
    "gate_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "replay_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "determinism_confidence": {
      "$ref": "#/definitions/binomialConfidence"
    },
    "runs_completed": {
      "type": "integer",
      "minimum": 0
    },
    "runs_failed": {
      "type": "integer",
      "minimum": 0
    },
    "total_runs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "definitions": {
    "binomialConfidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successes", "samples", "lower", "upper", "level"],
      "properties": {
        "successes": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
