{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codefoundry.ai/schemas/status.schema.json",
  "title": "CodeFoundry Stage Status Schema",
  "description": "Schema for stage status.json files",
  "type": "object",
  "required": ["schema_version", "stage_id", "status"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["codefoundry_stage_status.v1"],
      "description": "Schema version identifier"
    },
    "stage_id": {
      "type": "string",
      "description": "Identifier of the stage"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "pass", "fail", "skipped"],
      "description": "Current status of the stage"
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary"
    },
    "evidence": {
      "type": "array",
      "description": "Paths to evidence files",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when stage started"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when stage completed"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Duration in milliseconds"
    },
    "error": {
      "type": "string",
      "description": "Error message if stage failed"
    },
    "metadata": {
      "type": "object",
      "description": "Additional stage-specific metadata",
      "additionalProperties": true
    }
  }
}
