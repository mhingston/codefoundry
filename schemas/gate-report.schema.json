{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codefoundry.ai/schemas/gate-report.schema.json",
  "title": "CodeFoundry Gate Report Schema",
  "description": "Schema for gate execution reports",
  "type": "object",
  "required": ["schema_version", "gate_id", "status"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["codefoundry_gate_report.v1"],
      "description": "Schema version identifier"
    },
    "gate_id": {
      "type": "string",
      "description": "Identifier of the gate"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "error", "skipped"],
      "description": "Execution status"
    },
    "command": {
      "type": "string",
      "description": "Command that was executed"
    },
    "exit_code": {
      "type": "integer",
      "description": "Process exit code"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Execution duration in milliseconds"
    },
    "stdout": {
      "type": "string",
      "description": "Standard output from command"
    },
    "stderr": {
      "type": "string",
      "description": "Standard error from command"
    },
    "failures": {
      "type": "array",
      "description": "List of failures found",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info"]
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "metadata": {
      "type": "object",
      "description": "Additional gate-specific metadata",
      "additionalProperties": true
    }
  }
}
